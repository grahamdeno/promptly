<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist. Background refresh keeps alarms in step with calendar changes. -->
	<!-- Xcode has no INFOPLIST_KEY_ mapping for this one, so it lives here. Without it AlarmKit won't schedule. -->
	<key>NSAlarmKitUsageDescription</key>
	<string>Meetings ring like an alarm, even in Silent and Focus. Full screen when your phone is locked, a banner at the top when you're using it.</string>
	<!-- The Lock Screen and Dynamic Island countdown card (PromptlyWidgets). -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- promptly://meeting?id=… opens the Now screen from the card. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.grahamdeno.promptly</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>promptly</string>
			</array>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.grahamdeno.promptly.refresh</string>
	</array>
</dict>
</plist>
