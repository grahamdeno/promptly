<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Home Screen widget reads the app's meeting snapshot from the shared App Group. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.grahamdeno.promptly</string>
	</array>
</dict>
</plist>
